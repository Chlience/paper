{
  "name": "chlience-paper-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:content": "node scripts/build-paper-data.mjs",
    "build:conferences": "node scripts/build-conference-data.mjs",
    "build:mainlines": "node scripts/build-mainline-data.mjs",
    "check:conferences": "node scripts/check-conference-data.mjs && node scripts/build-conference-data.mjs && node --test scripts/check-conference-data.test.mjs",
    "check:mainlines": "node scripts/check-research-mainlines.mjs && node --test scripts/check-research-mainlines.test.mjs",
    "dev": "npm run build:content && npm run build:conferences && npm run build:mainlines && astro dev",
    "build": "npm run build:content && npm run build:conferences && npm run build:mainlines && astro build",
    "test:search": "node scripts/check-paper-search.mjs",
    "test:pins": "node scripts/check-pinned-papers.mjs",
    "test:figures": "node scripts/check-paper-figure-dialog.mjs",
    "test:dialog-scroll": "node scripts/check-paper-dialog-scroll.mjs",
    "test:dialog-interaction": "node scripts/check-paper-dialog-interaction.mjs",
    "test:workflow": "node --test scripts/check-paper-workflow.test.mjs",
    "check:metadata": "node scripts/check-paper-metadata.mjs",
    "check:workflow": "node scripts/check-paper-workflow.mjs",
    "check:site": "npm run check:metadata && npm run check:workflow && node scripts/check-paper-site.mjs",
    "check:math": "npm run build:content && node scripts/check-markdown-math.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.2.2",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-texmath": "^1.0.0"
  }
}
