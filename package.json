{
  "name": "chlience-paper-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:content": "node scripts/build-paper-data.mjs",
    "dev": "npm run build:content && astro dev",
    "build": "npm run build:content && astro build",
    "test:search": "node scripts/check-paper-search.mjs",
    "test:dialog-scroll": "node scripts/check-paper-dialog-scroll.mjs",
    "test:dialog-interaction": "node scripts/check-paper-dialog-interaction.mjs",
    "check:metadata": "node scripts/check-paper-metadata.mjs",
    "check:site": "npm run check:metadata && node scripts/check-paper-site.mjs",
    "check:math": "npm run build:content && node scripts/check-markdown-math.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.2.2",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-texmath": "^1.0.0"
  }
}
