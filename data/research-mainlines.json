{
  "snapshot": "2026-07-16",
  "paperCount": 102,
  "lines": [
    {
      "id": "resource-frontier",
      "name": "资源约束下的模型扩展",
      "question": "固定算力、显存与互连条件下，怎样扩大有效模型容量并让训练闭环可运行？",
      "thesis": "主线从参数规模律与compute-optimal配比出发，经由状态分片、MoE条件计算与通信优化，进一步走向优化器、低精度、条件记忆和模型—系统协同设计。有效扩展由激活参数、数据、通信、内存和数值稳定性的联合预算决定。",
      "boundary": "长序列内部的状态保留与attention访问归入“长历史的状态选择与访问”；后训练rollout与策略一致性归入“保持策略语义的分布式 RL 系统”。",
      "status": "consensus",
      "statusLabel": "共识约束"
    },
    {
      "id": "context-state",
      "name": "长历史的状态选择与访问",
      "question": "上下文增长后，哪些状态应保留、压缩或检索，并怎样以可控计算访问？",
      "thesis": "主线从exact attention的IO优化与跨设备context parallel起步，扩展到线性、稀疏、混合attention和分层KV存储，再进入agent可学习压缩与可恢复记忆。核心变量是状态可见集合、表示形式、驻留层级和访问成本。",
      "boundary": "请求级KV所有权、batch调度和workflow执行归入“语义感知的推理与 Agent Runtime”；通用模型容量扩展归入“资源约束下的模型扩展”。",
      "status": "competing",
      "statusLabel": "竞争路线"
    },
    {
      "id": "agent-runtime",
      "name": "语义感知的推理与 Agent Runtime",
      "question": "服务端怎样利用工作流结构、KV所有权与推测执行减少延迟和冗余？",
      "thesis": "主线从chunked batching和lossless token speculation开始，逐步把调度对象提升为span、semantic variable、DAG微任务、工具动作与agent session，并通过请求所有权、跨布局通信和可编辑KV维持执行语义。",
      "boundary": "attention表示和长历史选择归入“长历史的状态选择与访问”；训练rollout吞吐、policy lag与数值一致性归入“保持策略语义的分布式 RL 系统”。",
      "status": "consensus",
      "statusLabel": "共识约束"
    },
    {
      "id": "agent-environments",
      "name": "可执行环境驱动的 Agent 能力",
      "question": "Agent怎样从环境、工具和经验中获得可迁移能力？",
      "thesis": "可执行sandbox、computer-use环境、工具反馈、合成任务和经验演化共同构成agent训练的数据供给；能力能否迁移取决于环境真实性、状态协议、验证信号和模型—训练—环境闭环。",
      "boundary": "探索与reasoning能力边界归入“Reasoning RL 的能力边界与探索”；局部信用归入“从终局成败到局部信用与验证”；分布式训练编排归入“保持策略语义的分布式 RL 系统”。",
      "status": "emerging",
      "statusLabel": "新兴方向"
    },
    {
      "id": "reasoning-boundary",
      "name": "Reasoning RL 的能力边界与探索",
      "question": "可验证奖励下，RL何时能发现新解法、何时主要重排基座能力，怎样分配探索和长思考预算？",
      "thesis": "基座支持集、题目难度、可验证性和训练分布决定RL起点；entropy、宽度、长度和采样预算控制可达区域。主线由长CoT配方走向按任务分区的动态边界，并以pass@k、支持集和采样效率替代单一pass@1解释。",
      "boundary": "credit estimator与process verifier归入“从终局成败到局部信用与验证”；执行一致性归入“保持策略语义的分布式 RL 系统”；reward真实性归入“优化压力下的奖励与证据完整性”。",
      "status": "competing",
      "statusLabel": "竞争解释"
    },
    {
      "id": "credit-verification",
      "name": "从终局成败到局部信用与验证",
      "question": "怎样把终局成败和多样候选转成步骤、token或轨迹级可学习信号？",
      "thesis": "过程监督、verifier、reset反事实、token baseline和隐式value把稀疏结果下沉为局部progress；Best-of-N与search-and-aggregate产生的验证计算还能回流训练。有效信号需要保持策略序、控制偏差并匹配生成分布。",
      "boundary": "探索覆盖归入“Reasoning RL 的能力边界与探索”；异步执行与policy lag归入“保持策略语义的分布式 RL 系统”；verifier被过优化后的完整性归入“优化压力下的奖励与证据完整性”。",
      "status": "competing",
      "statusLabel": "竞争路线"
    },
    {
      "id": "rl-systems",
      "name": "保持策略语义的分布式 RL 系统",
      "question": "分布式LLM RL怎样提高吞吐，同时保持on-policy更新与可复现实验语义？",
      "thesis": "训练、rollout、reward和参数同步的异构数据流决定吞吐；异步程度、importance ratio、trust region、数值kernel和随机性决定样本是否仍可用于目标策略。系统优化需要把policy lag和train–infer mismatch列为算法变量。",
      "boundary": "纯推理服务归入“语义感知的推理与 Agent Runtime”；reasoning探索策略归入“Reasoning RL 的能力边界与探索”；credit estimator本身归入“从终局成败到局部信用与验证”。",
      "status": "consensus",
      "statusLabel": "共识约束"
    },
    {
      "id": "reward-integrity",
      "name": "优化压力下的奖励与证据完整性",
      "question": "奖励、评测与监控信号怎样在强选择和策略分布偏移下保持可信？",
      "thesis": "proxy相关性会随occupancy shift、Best-of-N选择强度和模型先验放大而失效；unit tests、社会规则、reasoning monitor和类人解释都可能成为可优化接口。防线包括因果约束、occupancy正则、悲观估计、负控评测和独立监控。",
      "boundary": "一般能力扩展归入“Reasoning RL 的能力边界与探索”；正常credit assignment归入“从终局成败到局部信用与验证”；环境供给归入“可执行环境驱动的 Agent 能力”。",
      "status": "consensus",
      "statusLabel": "共识风险"
    }
  ],
