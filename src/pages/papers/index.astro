---
import PaperRow from '../../components/PaperRow.astro';
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';

const searchablePapers = data.papers.map((paper) => ({
  paper,
  searchText: [
    paper.title,
    paper.summary,
    paper.authors,
    paper.slug,
    paper.subjects,
    paper.currentVersion,
    ...(paper.tags ?? []),
  ]
    .filter(Boolean)
    .join(' ')
    .toLocaleLowerCase(),
}));

const papersByTag = data.tags.map((tag) => ({
  tag,
  papers: data.papers.filter((paper) => paper.tags.includes(tag)),
}));
---

<Layout active="papers" title="Papers | Chlience Paper Archive" canonicalPath="/papers/">
  <section class="page-header container">
    <p class="eyebrow mono">All notes</p>
    <h1>论文笔记</h1>
    <p class="deck">当前收录 {data.papers.length} 篇论文或技术文章。列表保留摘要和作者线索，主题入口用于横向比较。</p>
  </section>

  <section class="section compact">
    <div class="container paper-search" data-paper-search>
      <div class="paper-search-field">
        <label for="paper-search-input">搜索论文</label>
        <div class="paper-search-control">
          <input
            id="paper-search-input"
            data-paper-search-input
            type="search"
            inputmode="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="标题、作者、主题或 slug"
            aria-describedby="paper-search-status"
          />
          <button type="button" data-paper-search-clear hidden>清空</button>
        </div>
      </div>
      <p id="paper-search-status" class="paper-search-status mono" data-paper-search-status>
        共 {data.papers.length} 篇
      </p>
    </div>

    <div class="container paper-list">
      {searchablePapers.map(({ paper, searchText }) => <PaperRow paper={paper} searchText={searchText} />)}
      <p class="paper-search-empty" data-paper-search-empty hidden>没有匹配的论文。</p>
    </div>
  </section>

  <section class="section">
    <div class="container section-header">
      <div>
        <h2>Topic Routes</h2>
        <p>同一篇文章可以进入多个问题域，但每个入口只保留和该主题直接相关的论文。</p>
      </div>
    </div>

    <div class="container theme-stack">
      {papersByTag.map(({ tag, papers }) => (
        <section class="theme-section" id={`tag-${tag.toLowerCase()}`}>
          <h3>{tag}</h3>
          <div class="theme-links">
            {papers.map((paper) => <a href={paper.path}>{paper.title}</a>)}
          </div>
        </section>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const searchRoot = document.querySelector('[data-paper-search]');
      const input = searchRoot?.querySelector('[data-paper-search-input]');
      const status = searchRoot?.querySelector('[data-paper-search-status]');
      const clearButton = searchRoot?.querySelector('[data-paper-search-clear]');
      const rows = Array.from(document.querySelectorAll('[data-paper-row]'));
      const emptyState = document.querySelector('[data-paper-search-empty]');

      if (!(input instanceof HTMLInputElement) || !status || !clearButton || !emptyState) return;

      const total = rows.length;
      const normalize = (value) => value.trim().toLocaleLowerCase();
      const getTerms = (value) => normalize(value).split(/\s+/).filter(Boolean);

      const setUrlQuery = (query) => {
        const url = new URL(window.location.href);
        if (query) {
          url.searchParams.set('q', query);
        } else {
          url.searchParams.delete('q');
        }
        window.history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
      };

      const applySearch = () => {
        const query = normalize(input.value);
        const terms = getTerms(input.value);
        let visibleCount = 0;

        rows.forEach((row) => {
          if (!(row instanceof HTMLElement)) return;
          const searchText = row.dataset.search ?? '';
          const isVisible = terms.every((term) => searchText.includes(term));
          row.hidden = !isVisible;
          if (isVisible) visibleCount += 1;
        });

        clearButton.hidden = query.length === 0;
        emptyState.hidden = visibleCount > 0;
        status.textContent = query ? `匹配 ${visibleCount} / ${total} 篇` : `共 ${total} 篇`;
        setUrlQuery(query);
      };

      clearButton.addEventListener('click', () => {
        input.value = '';
        input.focus();
        applySearch();
      });

      input.addEventListener('input', applySearch);

      const initialQuery = new URLSearchParams(window.location.search).get('q');
      if (initialQuery) {
        input.value = initialQuery;
        applySearch();
      }
    })();
  </script>
</Layout>
