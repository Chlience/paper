---
import PaperRow from '../../components/PaperRow.astro';
import DirectoryPagination from '../../components/DirectoryPagination.astro';
import '../../styles/directory.css';
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';
import { countPaperReviewStatuses, PAPER_REVIEW_DEFINITIONS } from '../../lib/paper-review.mjs';

const reviewCounts = countPaperReviewStatuses(data.papers);
---

<Layout active="papers" title="Papers | Chlience Paper Archive" canonicalPath="/papers/">
  <section class="page-header container">
    <p class="eyebrow">全部笔记</p>
    <h1>论文笔记</h1>
    <p class="deck">当前收录 {data.papers.length} 篇论文或技术文章。全部与待审阅按归档时间、已审阅按审阅时间排列，均为最新优先。</p>
  </section>

  <section class="section compact" data-paper-review-root>
    <div class="container">
      <div class="paper-review-toolbar">
        <nav class="paper-review-filter" aria-label="按审阅状态筛选论文">
          {PAPER_REVIEW_DEFINITIONS.map(({ id, label }) => (
            <a
              href={id === 'all' ? '/papers/' : `/papers/?review=${id}`}
              data-paper-review-filter={id}
              class:list={[id === 'all' && 'is-active']}
              aria-current={id === 'all' ? 'true' : undefined}
            >
              <span>{label}</span>
              <span class="paper-review-filter-count mono">{reviewCounts[id]}</span>
            </a>
          ))}
        </nav>
        <p class="paper-review-summary" data-paper-review-summary aria-live="polite">
          显示 {reviewCounts.all} / {reviewCounts.all} 篇
        </p>
      </div>

      <div class="directory-controls" data-directory-controls hidden>
        <label class="directory-query">搜索笔记
          <input type="search" data-directory-query placeholder="标题、作者或关键词" aria-label="搜索论文笔记" />
        </label>
        <label>研究主题
          <select data-directory-tag aria-label="筛选研究主题">
            <option value="">全部主题</option>
            {data.tagRoutes.map((tag) => <option value={tag.id}>{tag.label} · {tag.count}</option>)}
          </select>
        </label>
      </div>

      <div class="paper-list">
        {data.papers.map((paper) => <PaperRow paper={paper} />)}
      </div>
      <p class="paper-review-empty" data-paper-review-empty hidden>当前筛选下没有论文。</p>
      <DirectoryPagination />
    </div>
  </section>

<script>
  import { matchesDirectoryQuery, paginateDirectory } from '../../lib/directory.mjs';
  import {
    comparePapersForReviewFilter,
    normalizePaperReviewFilter,
    paperReviewLabel,
    paperReviewSortDefinition,
  } from '../../lib/paper-review.mjs';

  const root = document.querySelector('[data-paper-review-root]');

  if (root instanceof HTMLElement) {
    const rows = Array.from(root.querySelectorAll('[data-paper-review-status]'));
    const filters = Array.from(root.querySelectorAll('[data-paper-review-filter]'));
    const list = root.querySelector('.paper-list');
    const summary = root.querySelector('[data-paper-review-summary]');
    const empty = root.querySelector('[data-paper-review-empty]');
    const queryInput = root.querySelector('[data-directory-query]') as HTMLInputElement;
    const tagInput = root.querySelector('[data-directory-tag]') as HTMLSelectElement;
    const pagination = root.querySelector('[data-directory-pagination]') as HTMLElement;
    const previous = root.querySelector('[data-directory-prev]') as HTMLButtonElement;
    const next = root.querySelector('[data-directory-next]') as HTMLButtonElement;
    const pageSummary = root.querySelector('[data-directory-page-summary]') as HTMLElement;
    root.querySelector('[data-directory-controls]')?.removeAttribute('hidden');
    let currentPage = 1;
    let currentFilter = 'all';
    const searchText = new Map(rows.map((row) => [row,
      `${row.textContent} ${row.getAttribute('data-paper-authors') ?? ''}`,
    ]));

    const paperFromRow = (row) => ({
      slug: row.getAttribute('data-paper-slug') ?? '',
      firstArchivedAt: row.getAttribute('data-paper-first-archived-at') ?? '',
      updatedAt: row.getAttribute('data-paper-updated-at') ?? '',
      reviewedAt: row.getAttribute('data-paper-reviewed-at') ?? '',
      pinned: row.getAttribute('data-paper-pinned') === 'true',
    });

    const showDateField = (row, requestedField) => {
      const dateOptions = Array.from(row.querySelectorAll('[data-paper-date-field]'));
      const activeField = dateOptions.some(
        (option) => option.getAttribute('data-paper-date-field') === requestedField,
      )
        ? requestedField
        : 'firstArchivedAt';

      for (const option of dateOptions) {
        option.toggleAttribute('hidden', option.getAttribute('data-paper-date-field') !== activeField);
      }
    };

    const applyFilter = (value, updateHistory: false | 'push' | 'replace' = false, requestedPage = 1) => {
      const filter = normalizePaperReviewFilter(value);
      currentFilter = filter;
      const sortDefinition = paperReviewSortDefinition(filter);
      const sortedRows = [...rows].sort((left, right) =>
        comparePapersForReviewFilter(paperFromRow(left), paperFromRow(right), filter),
      );
      const matches = sortedRows.filter((row) =>
        (filter === 'all' || row.getAttribute('data-paper-review-status') === filter) &&
        (!tagInput.value || row.getAttribute('data-paper-tag-ids')?.split(' ').includes(tagInput.value)) &&
        matchesDirectoryQuery(searchText.get(row), queryInput.value),
      );
      const page = paginateDirectory(matches, requestedPage);
      currentPage = page.page;
      const visibleRows = new Set(page.items);

      if (list instanceof HTMLElement) list.append(...sortedRows);

      for (const row of sortedRows) {
        const visible = visibleRows.has(row);
        row.toggleAttribute('hidden', !visible);
        showDateField(row, sortDefinition.field);
      }

      for (const link of filters) {
        const active = link.getAttribute('data-paper-review-filter') === filter;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
        const target = new URL('/papers/', window.location.origin);
        const review = link.getAttribute('data-paper-review-filter');
        if (review !== 'all') target.searchParams.set('review', review);
        if (queryInput.value.trim()) target.searchParams.set('q', queryInput.value.trim());
        if (tagInput.value) target.searchParams.set('tag', tagInput.value);
        link.setAttribute('href', `${target.pathname}${target.search}`);
      }

      if (summary instanceof HTMLElement) {
        summary.textContent = `匹配 ${page.total} / ${rows.length} 篇 · 本页 ${page.items.length} 篇 · ${paperReviewLabel(filter)} · 按${sortDefinition.label}`;
      }
      if (empty instanceof HTMLElement) {
        empty.hidden = page.total > 0;
        empty.textContent = '当前筛选下没有论文，请调整关键词、主题或审阅状态。';
      }
      pagination.hidden = page.pageCount <= 1;
      previous.disabled = page.page <= 1;
      next.disabled = page.page >= page.pageCount;
      pageSummary.textContent = `第 ${page.page} / ${page.pageCount} 页`;

      if (updateHistory) {
        const url = new URL(window.location.href);
        if (filter === 'all') url.searchParams.delete('review');
        else url.searchParams.set('review', filter);
        for (const [key, value] of [['q', queryInput.value.trim()], ['tag', tagInput.value], ['page', page.page > 1 ? String(page.page) : '']]) {
          if (value) url.searchParams.set(key, value);
          else url.searchParams.delete(key);
        }
        window.history[updateHistory === 'push' ? 'pushState' : 'replaceState']({}, '', url);
      }
    };

    for (const link of filters) {
      link.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }
        event.preventDefault();
        applyFilter(link.getAttribute('data-paper-review-filter'), 'push');
      });
    }

    const applyUrlFilter = () => {
      const url = new URL(window.location.href);
      const filter = normalizePaperReviewFilter(url.searchParams.get('review'));
      if (url.searchParams.has('review') && filter === 'all') {
        url.searchParams.delete('review');
        window.history.replaceState({ review: filter }, '', url);
      }
      queryInput.value = url.searchParams.get('q') ?? '';
      const tag = url.searchParams.get('tag') ?? '';
      tagInput.value = Array.from(tagInput.options).some((option) => option.value === tag) ? tag : '';
      applyFilter(filter, 'replace', Number(url.searchParams.get('page') ?? 1));
    };

    queryInput.addEventListener('input', () => applyFilter(currentFilter, 'replace'));
    tagInput.addEventListener('change', () => applyFilter(currentFilter, 'push'));
    const changePage = (page) => {
      applyFilter(currentFilter, 'push', page);
      root.scrollIntoView({ block: 'start' });
      (list?.querySelector('.paper-row:not([hidden]) h3 a') as HTMLElement)?.focus({ preventScroll: true });
    };
    previous.addEventListener('click', () => changePage(currentPage - 1));
    next.addEventListener('click', () => changePage(currentPage + 1));

    window.addEventListener('popstate', applyUrlFilter);
    applyUrlFilter();
  }
</script>
</Layout>

<style>
  .page-header {
    padding: 36px 0 28px;
  }

  .page-header h1 {
    font-size: clamp(32px, 5vw, 52px);
  }

  @media (max-width: 680px) {
    .paper-review-filter {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .paper-review-filter a {
      padding-inline: 10px;
      gap: 6px;
      font-size: 13px;
    }
  }
</style>
