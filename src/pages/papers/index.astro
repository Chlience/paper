---
import PaperRow from '../../components/PaperRow.astro';
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';
---

<Layout active="papers" title="Papers | Chlience Paper Archive" canonicalPath="/papers/">
  <section class="page-header container">
    <p class="eyebrow mono">All notes</p>
    <h1>论文笔记</h1>
    <p class="deck">当前收录 {data.papers.length} 篇论文或技术文章，按首次归档时间排列并保留摘要与作者线索。</p>
  </section>

  <section class="section compact">
    <div class="container paper-list">
      {data.papers.map((paper) => <PaperRow paper={paper} />)}
    </div>
  </section>

</Layout>
