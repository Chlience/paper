---
import AuthorList from '../../components/AuthorList.astro';
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';
import { createArticleJsonLd, getAbsoluteUrl } from '../../lib/site';

export function getStaticPaths() {
  return data.papers.map((paper) => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const canonicalPath = paper.path;
const articleUrl = getAbsoluteUrl(canonicalPath, Astro.site);
const h2Headings = paper.headings.filter((heading) => heading.depth === 2);
---

<Layout
  active="papers"
  title={`${paper.title} | Chlience Paper Archive`}
  description={paper.summary}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={createArticleJsonLd({
    title: paper.title,
    description: paper.summary,
    url: articleUrl,
    firstArchivedAt: paper.firstArchivedAt,
    updatedAt: paper.updatedAt,
    authors: paper.authors,
  })}
>
  <article class="paper-page container">
    <header class="paper-header">
      <p class="eyebrow mono">{paper.slug}</p>
      <h1>{paper.title}</h1>
      <p class="deck">{paper.summary}</p>
      {paper.authors && paper.authors !== 'Unknown' && (
        <p class="paper-authors">
          <span class="paper-authors-label mono">Authors</span>
          <AuthorList authors={paper.authors} authorEntries={paper.authorEntries} />
        </p>
      )}
      <div class="paper-meta">
        {paper.pinned && <span class="paper-pin">Pinned</span>}
        {paper.firstArchivedAt && <span>{paper.firstArchivedAt}</span>}
        {paper.updatedAt && paper.updatedAt !== paper.firstArchivedAt && <span>Updated {paper.updatedAt}</span>}
        {paper.currentVersion && <span>{paper.currentVersion}</span>}
        {paper.sourceUrl && <a href={paper.sourceUrl}>Source</a>}
        {paper.tags.map((tag, index) => <a href={`/topics/#tag-${paper.tagIds[index]}`}>{tag}</a>)}
      </div>
    </header>

    <div class="paper-layout">
      {h2Headings.length > 0 && (
        <aside class="toc" aria-label="目录">
          <strong>目录</strong>
          <nav>
            {h2Headings.map((heading) => <a href={`#${heading.id}`}>{heading.text}</a>)}
          </nav>
        </aside>
      )}
      <div class="prose" set:html={paper.html} />
    </div>
  </article>
</Layout>
