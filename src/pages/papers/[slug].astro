---
import AuthorList from '../../components/AuthorList.astro';
import ResearchSynthesisHeader from '../../components/ResearchSynthesisHeader.astro';
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';
import { createArticleJsonLd, getAbsoluteUrl } from '../../lib/site';
import { normalizePaperReviewStatus, paperReviewLabel } from '../../lib/paper-review.mjs';

export function getStaticPaths() {
  return data.papers.map((paper) => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const canonicalPath = paper.path;
const articleUrl = getAbsoluteUrl(canonicalPath, Astro.site);
const h2Headings = paper.headings.filter((heading) => heading.depth === 2);
const reviewStatus = normalizePaperReviewStatus(paper.reviewStatus);
const isSynthesis = paper.materialType === 'composite';
---

<Layout
  active="papers"
  title={`${paper.title} | Chlience Paper Archive`}
  description={paper.coreSignal}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={createArticleJsonLd({
    schemaType: isSynthesis ? 'Article' : 'ScholarlyArticle',
    title: paper.title,
    description: paper.coreSignal,
    url: articleUrl,
    firstArchivedAt: paper.firstArchivedAt,
    updatedAt: paper.updatedAt,
    authors: !isSynthesis && paper.authors !== 'Unknown' ? paper.authors : undefined,
    organizationAuthor: isSynthesis ? paper.responsibleOrganization : undefined,
  })}
>
  <article class:list={['paper-page', 'container', { 'is-synthesis': isSynthesis }]}>
    {isSynthesis ? (
      <ResearchSynthesisHeader paper={paper} reviewStatus={reviewStatus} />
    ) : (
      <header class="paper-header">
        <p class="eyebrow mono">{paper.slug}</p>
        <h1>{paper.title}</h1>
        <div class="deck" set:html={paper.conclusionHtml} />
        {paper.authors && paper.authors !== 'Unknown' && (
          <p class="paper-authors">
            <span class="paper-authors-label mono">Authors</span>
            <AuthorList authors={paper.authors} authorEntries={paper.authorEntries} />
          </p>
        )}
        <div class="paper-meta">
          <div class="paper-meta-line" role="group" aria-label="论文状态与来源">
            <span class:list={['paper-meta-item', 'paper-review-badge', `is-${reviewStatus}`]}>
              {paperReviewLabel(reviewStatus)}
            </span>
            {paper.pinned && <span class="paper-meta-item paper-pin">Pinned</span>}
            {paper.firstArchivedAt && <span class="paper-meta-item">Archived {paper.firstArchivedAt}</span>}
            {paper.updatedAt && paper.updatedAt !== paper.firstArchivedAt && (
              <span class="paper-meta-item">Updated {paper.updatedAt}</span>
            )}
            {paper.reviewedAt && <span class="paper-meta-item">Reviewed {paper.reviewedAt}</span>}
            {paper.sourceUrl && <a class="paper-meta-item" href={paper.sourceUrl}>Source</a>}
          </div>
          {paper.tags.length > 0 && (
            <div class="paper-meta-line paper-meta-topics" role="group" aria-label="论文主题">
              {paper.tags.map((tag, index) => (
                <a class="paper-topic" href={`/topics/#tag-${paper.tagIds[index]}`}>{tag}</a>
              ))}
            </div>
          )}
        </div>
      </header>
    )}

    <div class="paper-layout">
      {h2Headings.length > 0 && (
        <aside class="toc" aria-label="目录" data-paper-toc>
          <strong>{isSynthesis ? '阅读路径' : '目录'}</strong>
          <nav data-paper-toc-nav>
            {h2Headings.map((heading, index) => (
              <a
                href={`#${heading.id}`}
                data-paper-toc-link
                aria-current={index === 0 ? 'location' : undefined}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      )}
      <div class="prose" set:html={paper.html} />
    </div>
  </article>

  <script>
    const toc = document.querySelector('[data-paper-toc]');

    if (toc instanceof HTMLElement) {
      const nav = toc.querySelector('[data-paper-toc-nav]');
      const links = Array.from(toc.querySelectorAll('[data-paper-toc-link]')).filter(
        (link): link is HTMLAnchorElement => link instanceof HTMLAnchorElement,
      );
      const entries = links.flatMap((link) => {
        const target = link.getAttribute('href')?.slice(1);
        if (!target) return [];

        let id = target;
        try {
          id = decodeURIComponent(target);
        } catch {
          // Keep the authored fragment when it is not URI encoded.
        }

        const heading = document.getElementById(id);
        return heading ? [{ heading, link }] : [];
      });

      if (entries.length > 0) {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let activeId = '';
        let frame = 0;

        const keepActiveLinkVisible = (link: HTMLAnchorElement) => {
          if (!(nav instanceof HTMLElement) || nav.scrollHeight <= nav.clientHeight) return;

          const linkTop = link.offsetTop;
          const linkBottom = linkTop + link.offsetHeight;
          const visibleTop = nav.scrollTop;
          const visibleBottom = visibleTop + nav.clientHeight;
          if (linkTop >= visibleTop && linkBottom <= visibleBottom) return;

          const top = linkTop < visibleTop ? linkTop - 8 : linkBottom - nav.clientHeight + 8;
          nav.scrollTo({
            top: Math.max(0, top),
            behavior: reduceMotion.matches ? 'auto' : 'smooth',
          });
        };

        const activate = (entry: (typeof entries)[number]) => {
          if (entry.heading.id === activeId) return;
          activeId = entry.heading.id;

          for (const candidate of entries) {
            if (candidate === entry) {
              candidate.link.setAttribute('aria-current', 'location');
            } else {
              candidate.link.removeAttribute('aria-current');
            }
          }
          keepActiveLinkVisible(entry.link);
        };

        const updateActiveHeading = () => {
          frame = 0;
          const headingOffset = 104;
          const pageBottom = window.scrollY + window.innerHeight;
          const documentBottom = document.documentElement.scrollHeight;
          let active = entries[0];

          if (pageBottom >= documentBottom - 2) {
            active = entries.at(-1) ?? active;
          } else {
            for (const entry of entries) {
              if (entry.heading.getBoundingClientRect().top > headingOffset) break;
              active = entry;
            }
          }
          activate(active);
        };

        const scheduleUpdate = () => {
          if (frame) return;
          frame = window.requestAnimationFrame(updateActiveHeading);
        };

        for (const entry of entries) {
          entry.link.addEventListener('click', () => activate(entry));
        }
        window.addEventListener('scroll', scheduleUpdate, { passive: true });
        window.addEventListener('resize', scheduleUpdate);
        window.addEventListener('hashchange', scheduleUpdate);
        scheduleUpdate();
      }
    }
  </script>
</Layout>
