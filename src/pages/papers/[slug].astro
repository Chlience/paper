---
import AuthorList from '../../components/AuthorList.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';
import mainlineData from '../../generated/mainline-data.json';
import { createArticleJsonLd, getAbsoluteUrl } from '../../lib/site';
import { normalizePaperReviewStatus, paperReviewLabel } from '../../lib/paper-review.mjs';

export function getStaticPaths() {
  return data.papers.map((paper) => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const canonicalPath = paper.path;
const articleUrl = getAbsoluteUrl(canonicalPath, Astro.site);
const reviewStatus = normalizePaperReviewStatus(paper.reviewStatus);
const relatedMainlines = mainlineData.mainlines.filter((mainline) => mainline.includedPaperSlugs.includes(paper.slug));
---

<Layout
  active="papers"
  title={`${paper.title} | Chlience Paper Archive`}
  description={paper.coreSignal}
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={createArticleJsonLd({
    schemaType: 'ScholarlyArticle',
    title: paper.title,
    description: paper.coreSignal,
    url: articleUrl,
    firstArchivedAt: paper.firstArchivedAt,
    updatedAt: paper.updatedAt,
    authors: paper.authors !== 'Unknown' ? paper.authors : undefined,
  })}
>
  <article class="paper-page container">
    <header class="paper-header">
        <p class="eyebrow mono">{paper.slug}</p>
        <h1>{paper.title}</h1>
        <div class="deck" set:html={paper.conclusionHtml} />
        {paper.authors && paper.authors !== 'Unknown' && (
          <p class="paper-authors">
            <span class="paper-authors-label mono">Authors</span>
            <AuthorList authors={paper.authors} authorEntries={paper.authorEntries} />
          </p>
        )}
        <div class="paper-meta">
          <div class="paper-meta-line" role="group" aria-label="论文状态与来源">
            <span class:list={['paper-meta-item', 'paper-review-badge', `is-${reviewStatus}`]}>
              {paperReviewLabel(reviewStatus)}
            </span>
            {paper.pinned && <span class="paper-meta-item paper-pin">Pinned</span>}
            {paper.firstArchivedAt && <span class="paper-meta-item">Archived {paper.firstArchivedAt}</span>}
            {paper.updatedAt && paper.updatedAt !== paper.firstArchivedAt && (
              <span class="paper-meta-item">Updated {paper.updatedAt}</span>
            )}
            {paper.reviewedAt && <span class="paper-meta-item">Reviewed {paper.reviewedAt}</span>}
            {paper.sourceUrl && <a class="paper-meta-item" href={paper.sourceUrl}>Source</a>}
          </div>
          {paper.tags.length > 0 && (
            <div class="paper-meta-line paper-meta-topics" role="group" aria-label="论文主题">
              {paper.tags.map((tag, index) => (
                <a class="paper-topic" href={`/topics/#tag-${paper.tagIds[index]}`}>{tag}</a>
              ))}
            </div>
          )}
        </div>
    </header>

    <div class="paper-layout">
      <ArticleToc headings={paper.headings} />
      <div class="prose" set:html={paper.html} />
    </div>
    {relatedMainlines.length > 0 && (
      <aside class="paper-mainline-backlinks" aria-labelledby="paper-mainline-backlinks-title">
        <h2 id="paper-mainline-backlinks-title">进入研究主线</h2>
        <ul>
          {relatedMainlines.map((mainline) => (
            <li>
              <a href={mainline.path}>{mainline.title}</a>
              <span>{mainline.researchQuestion}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>

</Layout>
