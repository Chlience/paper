---
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';

const routeGroups = data.tagFacets.map((facet) => ({
  ...facet,
  routes: data.tagRoutes
    .filter((route) => route.facetId === facet.id)
    .map((route) => ({
      ...route,
      papers: data.papers.filter((paper) => paper.tagIds.includes(route.id)),
    })),
}));
---

<Layout
  active="topics"
  title="Topics | Chlience Paper Archive"
  description="按训练、推理、架构、Agent、评测、安全与理论浏览论文笔记。"
  canonicalPath="/topics/"
>
  <section class="page-header container topics-header">
    <p class="eyebrow mono">Research topics</p>
    <h1>研究主题</h1>
    <p class="deck">
      {data.tagRoutes.length} 个细粒度主题按核心贡献组织，同一篇论文可以连接多个直接相关的问题域。
    </p>
  </section>

  <nav class="container topic-facet-index" aria-label="主题领域">
    {routeGroups.map((group) => (
      <a href={`#facet-${group.id}`}>
        <span>{group.label}</span>
        <span class="mono">{group.routeCount} routes · {group.paperCount} notes</span>
      </a>
    ))}
  </nav>

  <section class="section topics-section">
    <div class="container theme-stack">
      {routeGroups.map((group) => (
        <section class="route-facet" id={`facet-${group.id}`}>
          <header class="route-facet-header">
            <p class="eyebrow mono">{group.routeCount} routes · {group.paperCount} notes</p>
            <h2>{group.label}</h2>
            <p>{group.description}</p>
          </header>
          <div class="route-sections">
            {group.routes.map((route) => (
              <section class="theme-section" id={`tag-${route.id}`}>
                <div class="theme-heading">
                  <h3>{route.label}</h3>
                  <span class="mono">{route.count}</span>
                </div>
                <p class="route-description">{route.description}</p>
                <div class="theme-links">
                  {route.papers.map((paper) => <a href={paper.path}>{paper.title}</a>)}
                </div>
              </section>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Layout>
