---
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/conference-data.json';

interface LatestEdition {
  year: number;
  submissionDeadline: string;
  conferenceDates: string;
  acceptedPapersUrl?: string;
  sourceUrls: string[];
}

interface ConferenceDirectoryEntry {
  id: string;
  acronym: string;
  name: string;
  ccfAreaId: string;
  ccfAreaLabel: string;
  latestEdition: LatestEdition;
}

const expectedConferenceDataSchemaVersion = 4;
if (data.schemaVersion !== expectedConferenceDataSchemaVersion) {
  throw new Error(
    `Conference page expected generated schemaVersion ${expectedConferenceDataSchemaVersion}, received ${data.schemaVersion}.`,
  );
}

const conferences = data.conferences as ConferenceDirectoryEntry[];

const safeExternalUrl = (value: string | undefined) => {
  try {
    const url = new URL(value ?? '');
    return ['http:', 'https:'].includes(url.protocol) ? url.href : '';
  } catch {
    return '';
  }
};

const snapshotValue = data.ccfSnapshot as unknown;
const snapshotRecord =
  snapshotValue && typeof snapshotValue === 'object'
    ? (snapshotValue as Record<string, unknown>)
    : null;
const snapshotLabel = String(
  snapshotRecord?.label ??
    snapshotRecord?.version ??
    (snapshotRecord?.edition ? `CCF 第 ${snapshotRecord.edition} 版` : 'CCF 目录'),
);
const snapshotDate = snapshotRecord?.correctedAt ?? snapshotRecord?.publishedAt;
const ccfSnapshot = snapshotDate ? `${snapshotLabel} · ${snapshotDate}` : snapshotLabel;
---

<Layout
  title="CCF-A Conference Directory | Chlience Paper Archive"
  description="查询非 CV 方向 CCF-A 会议的最新届次、截稿时间、会期和官方 Accepted Papers 入口。"
  canonicalPath="/conferences/"
>
  <section class="page-header container conference-page-header">
    <p class="eyebrow mono">CCF-A Conference Directory</p>
    <h1>会议目录</h1>
    <p class="deck">
      维护非 CV 方向 CCF-A 会议的最新完整届次，只记录主论文截稿、正式会期和官方 Accepted Papers
      入口。逐篇论文内容不在本目录保存。
    </p>

    <dl class="conference-scope-line" aria-label="目录范围">
      <div>
        <dt>目录快照</dt>
        <dd>{ccfSnapshot}</dd>
      </div>
      <div>
        <dt>会议范围</dt>
        <dd>{conferences.length} 个 · 排除 CVPR 与 ICCV</dd>
      </div>
      <div>
        <dt>信息核验</dt>
        <dd>{data.verifiedAt}</dd>
      </div>
    </dl>
  </section>

  <section class="section conference-directory-section" aria-labelledby="conference-directory-title">
    <div class="container">
      <div class="conference-section-intro">
        <h2 id="conference-directory-title">最新一届</h2>
        <p>
          日期链接指向会议或学会官方页面。Accepted Papers 入口尚未公布或尚待核验时，状态显示“待补充”。
        </p>
      </div>

      <div
        class="conference-directory-table-wrap"
        role="region"
        aria-label="CCF-A 会议目录，可横向滚动"
        tabindex="0"
      >
        <table class="conference-directory-table">
          <thead>
            <tr>
              <th scope="col">会议</th>
              <th scope="col">领域</th>
              <th scope="col">状态</th>
              <th scope="col">最新一届截稿 / 会期</th>
              <th scope="col">Accepted Papers</th>
            </tr>
          </thead>
          <tbody>
            {conferences.map((conference) => {
              const acceptedPapersUrl = safeExternalUrl(
                conference.latestEdition.acceptedPapersUrl,
              );
              const dateSourceUrl = safeExternalUrl(conference.latestEdition.sourceUrls[0]);

              return (
                <tr>
                  <th scope="row">
                    <span>{conference.acronym}</span>
                    {conference.name !== conference.acronym && <small>{conference.name}</small>}
                  </th>
                  <td class="conference-directory-area">{conference.ccfAreaLabel}</td>
                  <td>
                    <span
                      class:list={[
                        'conference-directory-status',
                        acceptedPapersUrl ? 'is-available' : 'is-pending',
                      ]}
                    >
                      {acceptedPapersUrl ? '已公布' : '待补充'}
                    </span>
                  </td>
                  <td class="conference-latest-edition">
                    <span class="conference-latest-edition-year mono">
                      {conference.latestEdition.year} 届
                    </span>
                    <dl>
                      <div>
                        <dt>截稿</dt>
                        <dd>{conference.latestEdition.submissionDeadline}</dd>
                      </div>
                      <div>
                        <dt>会期</dt>
                        <dd>{conference.latestEdition.conferenceDates}</dd>
                      </div>
                    </dl>
                    {dateSourceUrl && (
                      <a class="conference-date-source" href={dateSourceUrl}>核验日期</a>
                    )}
                  </td>
                  <td class="conference-directory-action">
                    {acceptedPapersUrl ? (
                      <a href={acceptedPapersUrl}>查看 Accepted Papers</a>
                    ) : (
                      <span>待补充</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>
