---
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';

const trackedAuthors = data.authors.filter((author) => author.profileStatus === 'tracked');
const recurringAuthors = data.authors.filter((author) => author.profileStatus === 'recurring');
---

<Layout
  active="authors"
  title="Authors | Chlience Paper Archive"
  description="作者档案、个人主页代表性论文、已归档论文、机构线索和公开账号核验。"
  canonicalPath="/authors/"
>
  <section class="page-header container">
    <p class="eyebrow mono">Author graph</p>
    <h1>作者档案</h1>
    <p class="deck">
      作者页把稳定身份信息、个人主页重点论文、公开账号、机构线索和本站已归档论文聚合到一处。已建档作者来自人工维护的 registry；跨论文重复出现的作者由构建脚本自动生成轻量页面。
    </p>
  </section>

  <section class="section compact">
    <div class="container author-stats">
      <div>
        <span class="mono">{trackedAuthors.length}</span>
        <strong>tracked profiles</strong>
      </div>
      <div>
        <span class="mono">{recurringAuthors.length}</span>
        <strong>recurring authors</strong>
      </div>
      <div>
        <span class="mono">{data.papers.length}</span>
        <strong>archived notes</strong>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container section-header">
      <div>
        <h2>Tracked Profiles</h2>
        <p>这些作者已经有人类核验的主页、账号或机构信息。</p>
      </div>
    </div>
    <div class="container author-grid">
      {trackedAuthors.map((author) => (
        <a class="author-card" href={author.path}>
          <span class="mono">{author.paperCount} notes</span>
          <strong>{author.displayName ?? author.name}</strong>
          {author.affiliations.length > 0 && <p>{author.affiliations.slice(0, 2).join(' / ')}</p>}
          {author.topics.length > 0 && (
            <div class="author-topic-row">
              {author.topics.slice(0, 4).map((topic) => <span>{topic}</span>)}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>

  {recurringAuthors.length > 0 && (
    <section class="section">
      <div class="container section-header">
        <div>
          <h2>Recurring Authors</h2>
          <p>这些作者在当前归档中至少出现两次，页面由论文元数据自动汇总。</p>
        </div>
      </div>
      <div class="container author-list">
        {recurringAuthors.map((author) => (
          <a href={author.path}>
            <strong>{author.displayName ?? author.name}</strong>
            <span class="mono">{author.paperCount} notes</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
