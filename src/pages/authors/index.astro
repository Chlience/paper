---
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';
import DirectoryPagination from '../../components/DirectoryPagination.astro';
import '../../styles/directory.css';

const trackedAuthors = data.authors.filter((author) => author.profileStatus === 'tracked');
const recurringAuthors = data.authors.filter((author) => author.profileStatus === 'recurring');
---

<Layout
  active="authors"
  title="Authors | Chlience Paper Archive"
  description="作者档案、个人主页代表性论文、已归档论文、机构线索和公开账号核验。"
  canonicalPath="/authors/"
>
  <section class="page-header container">
    <p class="eyebrow">作者与研究联系</p>
    <h1>作者档案</h1>
    <p class="deck">
      按姓名或机构查找作者，查看身份来源、代表论文及本站笔记中的研究联系。
    </p>
  </section>

  <section class="section compact">
    <div class="container author-stats">
      <div>
        <span class="mono">{trackedAuthors.length}</span>
        <strong>已建档作者</strong>
      </div>
      <div>
        <span class="mono">{recurringAuthors.length}</span>
        <strong>多篇关联作者</strong>
      </div>
      <div>
        <span class="mono">{data.papers.length}</span>
        <strong>论文笔记</strong>
      </div>
    </div>
  </section>

  <section class="section" data-author-directory>
    <div class="container section-header">
      <div>
        <h2>浏览作者</h2>
        <p>已建档作者保留身份来源，多篇关联作者汇总当前笔记中的重复出现记录。</p>
      </div>
    </div>
    <div class="container">
      <div class="directory-controls" data-directory-controls hidden>
        <label class="directory-query">搜索作者
          <input type="search" data-directory-query placeholder="姓名或机构" aria-label="搜索作者" />
        </label>
        <label>档案范围
          <select data-directory-status>
            <option value="">全部作者</option>
            <option value="tracked">已建档</option>
            <option value="recurring">多篇关联</option>
          </select>
        </label>
        <label>排列方式
          <select data-directory-sort>
            <option value="papers">论文数量</option>
            <option value="name">姓名</option>
          </select>
        </label>
      </div>
      <p class="directory-summary" data-directory-summary aria-live="polite">共 {data.authors.length} 位作者</p>
    </div>
    <div class="container author-grid">
      {data.authors.map((author) => (
        <a class="author-card" href={author.path} data-directory-item data-author-status={author.profileStatus} data-author-name={author.displayName ?? author.name} data-author-paper-count={author.paperCount} data-author-search={`${author.name} ${author.displayName ?? ''} ${author.affiliations.join(' ')}`}>
          <span class="mono">{author.paperCount} 篇笔记 · {author.profileStatus === 'tracked' ? '已建档' : '多篇关联'}</span>
          <strong>{author.displayName ?? author.name}</strong>
          {author.affiliations.length > 0 && <p>{author.affiliations.slice(0, 2).join(' / ')}</p>}
          {author.topics.length > 0 && (
            <div class="author-topic-row">
              {author.topics.slice(0, 2).map((topic) => <span>{topic}</span>)}
            </div>
          )}
        </a>
      ))}
    </div>
    <div class="container"><DirectoryPagination /></div>
  </section>
</Layout>

<script>
  import { matchesDirectoryQuery, paginateDirectory } from '../../lib/directory.mjs';

  const root = document.querySelector('[data-author-directory]');
  if (root instanceof HTMLElement) {
    const grid = root.querySelector('.author-grid') as HTMLElement;
    const cards = Array.from(root.querySelectorAll('[data-directory-item]')) as HTMLElement[];
    const query = root.querySelector('[data-directory-query]') as HTMLInputElement;
    const status = root.querySelector('[data-directory-status]') as HTMLSelectElement;
    const sort = root.querySelector('[data-directory-sort]') as HTMLSelectElement;
    const summary = root.querySelector('[data-directory-summary]') as HTMLElement;
    const pagination = root.querySelector('[data-directory-pagination]') as HTMLElement;
    const previous = root.querySelector('[data-directory-prev]') as HTMLButtonElement;
    const next = root.querySelector('[data-directory-next]') as HTMLButtonElement;
    const pageSummary = root.querySelector('[data-directory-page-summary]') as HTMLElement;
    root.querySelector('[data-directory-controls]')?.removeAttribute('hidden');
    let currentPage = 1;

    const apply = (requestedPage = 1, historyMode: false | 'push' | 'replace' = false) => {
      const matches = cards.filter((card) =>
        (!status.value || card.dataset.authorStatus === status.value) &&
        matchesDirectoryQuery(card.dataset.authorSearch, query.value),
      ).sort((left, right) => {
        if (sort.value === 'name') return (left.dataset.authorName ?? '').localeCompare(right.dataset.authorName ?? '');
        return Number(right.dataset.authorPaperCount) - Number(left.dataset.authorPaperCount);
      });
      const page = paginateDirectory(matches, requestedPage);
      currentPage = page.page;
      const visible = new Set(page.items);
      for (const card of cards) card.hidden = !visible.has(card);
      grid.append(...matches);
      summary.textContent = page.total > 0
        ? `匹配 ${page.total} / ${cards.length} 位作者 · 本页 ${page.items.length} 位`
        : '没有匹配的作者，请调整姓名、机构或档案范围。';
      pagination.hidden = page.pageCount <= 1;
      previous.disabled = page.page <= 1;
      next.disabled = page.page >= page.pageCount;
      pageSummary.textContent = `第 ${page.page} / ${page.pageCount} 页`;
      if (historyMode) {
        const url = new URL(location.href);
        for (const [key, value] of [['q', query.value.trim()], ['profile', status.value], ['sort', sort.value === 'name' ? 'name' : ''], ['page', page.page > 1 ? String(page.page) : '']]) {
          if (value) url.searchParams.set(key, value);
          else url.searchParams.delete(key);
        }
        history[historyMode === 'push' ? 'pushState' : 'replaceState']({}, '', url);
      }
    };
    const applyUrl = () => {
      const url = new URL(location.href);
      query.value = url.searchParams.get('q') ?? '';
      const profile = url.searchParams.get('profile') ?? '';
      status.value = ['tracked', 'recurring'].includes(profile) ? profile : '';
      sort.value = url.searchParams.get('sort') === 'name' ? 'name' : 'papers';
      apply(Number(url.searchParams.get('page') ?? 1), 'replace');
    };
    query.addEventListener('input', () => apply(1, 'replace'));
    status.addEventListener('change', () => apply(1, 'push'));
    sort.addEventListener('change', () => apply(1, 'push'));
    const changePage = (value: number) => {
      apply(value, 'push');
      root.scrollIntoView({ block: 'start' });
      (grid.querySelector('[data-directory-item]:not([hidden])') as HTMLElement)?.focus({ preventScroll: true });
    };
    previous.addEventListener('click', () => changePage(currentPage - 1));
    next.addEventListener('click', () => changePage(currentPage + 1));
    window.addEventListener('popstate', applyUrl);
    applyUrl();
  }
</script>

<style>
  .page-header {
    padding: 36px 0 28px;
  }

  .page-header h1 {
    font-size: clamp(32px, 5vw, 52px);
  }

  .author-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .author-stats strong {
    font-size: 14px;
  }

  .author-grid {
    align-items: stretch;
  }

  @media (max-width: 680px) {
    .section {
      padding-top: 28px;
      padding-bottom: 28px;
    }
  }
</style>
