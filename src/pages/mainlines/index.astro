---
import Layout from '../../layouts/Layout.astro';
import mainlineData from '../../generated/mainline-data.json';

const mainlines = mainlineData.mainlines;
const pageDescription = `${mainlines.length} 条研究主线，围绕持续关注的问题比较材料、梳理证据并记录当前判断。`;
---

<Layout
  active="mainlines"
  title="研究主线 | Chlience Paper Archive"
  description={pageDescription}
  canonicalPath="/mainlines/"
>
  <article class="utility-page mainlines-page container">
    <header class="page-header mainlines-page-header">
      <p class="eyebrow">跨论文阅读</p>
      <h1>研究主线</h1>
      <p class="deck">{pageDescription}</p>
      <div class="mainlines-snapshot" aria-label="主线概况">
        <span>{mainlines.length} 条主线</span>
        <a href="/synthesis-workflow/">综合方法与更新说明</a>
      </div>
    </header>

    <div class="mainline-directory">
      {mainlines.map((mainline) => (
        <section class="mainline-facet mainline-overview-card" aria-labelledby={`mainline-${mainline.slug}`}>
          <header class="mainline-facet-header">
            <h2 id={`mainline-${mainline.slug}`}>
              <a href={mainline.path}>{mainline.title}</a>
            </h2>
          </header>
          <dl class="mainline-overview-fields">
            <div>
              <dt>核心问题</dt>
              <dd>{mainline.researchQuestion}</dd>
            </div>
            <div>
              <dt>当前判断 · 节选</dt>
              <dd class="mainline-judgment-excerpt">{mainline.currentJudgment}</dd>
            </div>
          </dl>
          <details class="mainline-scope">
            <summary>研究边界与分类框架</summary>
            <p>{mainline.boundary}</p>
            <p>{mainline.classificationAxes.join(' × ')}</p>
          </details>
          <footer class="mainline-directory-meta mono">
            <span>{mainline.localPaperCount} 篇本地论文</span>
            <span>{mainline.externalSourceCount} 项外部来源</span>
            <time datetime={mainline.updatedAt}>更新 {mainline.updatedAt}</time>
            <a href={mainline.path}>阅读全文 →</a>
          </footer>
        </section>
      ))}
    </div>
  </article>
</Layout>

<style>
  .page-header {
    padding: 36px 0 28px;
  }

  .page-header h1 {
    font-size: clamp(32px, 5vw, 52px);
  }

  .mainline-overview-fields {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .mainline-judgment-excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  .mainline-scope {
    grid-column: 2;
    font-size: 14px;
    color: var(--muted);
  }

  .mainline-scope summary {
    cursor: pointer;
    padding: 8px 0;
  }

  .mainline-scope p {
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .mainline-scope {
      grid-column: 1;
    }
  }
</style>
