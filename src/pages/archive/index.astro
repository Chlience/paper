---
import Layout from '../../layouts/Layout.astro';
import data from '../../generated/paper-data.json';

const archive = data.utilities.find((page) => page.slug === 'archive');
---

<Layout active="archive" title="Archive Index | Chlience Paper Archive" canonicalPath="/archive/">
  <article class="utility-page container">
    <header class="page-header slim">
      <p class="eyebrow mono">Index</p>
      <h1>{archive?.title}</h1>
      <p class="deck">完整索引、作者关系图谱和跨论文关系。</p>
    </header>
    <div class="prose wide" set:html={archive?.html ?? ''} />
  </article>
</Layout>
