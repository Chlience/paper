---
import { formatDate } from '../lib/site';

interface Paper {
  slug: string;
  path: string;
  title: string;
  date?: string;
  sourceUrl?: string;
  authors?: string;
  summary?: string;
  tags?: string[];
}

interface Props {
  paper: Paper;
  showProvenance?: boolean;
}

const { paper, showProvenance = true } = Astro.props;
---

<article class="paper-row">
  <div class="paper-row-date mono">{formatDate(paper.date)}</div>
  <div class="paper-row-main">
    <h3><a href={paper.path}>{paper.title}</a></h3>
    {paper.summary && <p>{paper.summary}</p>}
    {paper.authors && <p class="paper-row-authors">{paper.authors}</p>}
    <div class="paper-row-meta">
      {showProvenance && <span>{paper.slug}</span>}
      {showProvenance && paper.sourceUrl && <a class="source-link" href={paper.sourceUrl}>Source</a>}
      {paper.tags?.slice(0, 3).map((tag) => <a class="topic-link" href={`/papers/#tag-${tag.toLowerCase()}`}>{tag}</a>)}
    </div>
  </div>
</article>
