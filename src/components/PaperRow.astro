---
import AuthorList from './AuthorList.astro';
import { formatDate } from '../lib/site';
import { normalizePaperReviewStatus, paperReviewLabel } from '../lib/paper-review.mjs';

interface Paper {
  slug: string;
  path: string;
  title: string;
  firstArchivedAt?: string;
  updatedAt?: string;
  reviewStatus?: string;
  reviewedAt?: string;
  materialType?: string;
  pinned?: boolean;
  authors?: string;
  authorEntries?: { name: string; path?: string; slug?: string; profileStatus?: string }[];
  coreSignal?: string;
  tags?: string[];
  tagIds?: string[];
}

interface Props {
  paper: Paper;
  showProvenance?: boolean;
  dateField?: 'firstArchivedAt' | 'updatedAt' | 'reviewedAt';
}

const { paper, showProvenance = true, dateField = 'firstArchivedAt' } = Astro.props;
const reviewStatus = normalizePaperReviewStatus(paper.reviewStatus);
const dateOptions = [
  { field: 'firstArchivedAt', label: '归档', value: paper.firstArchivedAt },
  { field: 'updatedAt', label: '更新', value: paper.updatedAt },
  { field: 'reviewedAt', label: '审阅', value: paper.reviewedAt },
].filter(({ value }) => Boolean(value));
const visibleDateField = dateOptions.some(({ field }) => field === dateField) ? dateField : 'firstArchivedAt';
---

<article
  class="paper-row"
  data-paper-review-status={reviewStatus}
  data-paper-slug={paper.slug}
  data-paper-first-archived-at={paper.firstArchivedAt ?? ''}
  data-paper-updated-at={paper.updatedAt ?? ''}
  data-paper-reviewed-at={paper.reviewedAt ?? ''}
  data-paper-pinned={paper.pinned ? 'true' : 'false'}
  data-paper-authors={paper.authors ?? ''}
  data-paper-tag-ids={paper.tagIds?.join(' ') ?? ''}
>
  <div class="paper-row-date mono">
    {dateOptions.map(({ field, label, value }) => (
      <span class="paper-row-date-option" data-paper-date-field={field} hidden={field !== visibleDateField}>
        <span class="paper-row-date-label">{label}</span>
        <time datetime={value}>{formatDate(value)}</time>
      </span>
    ))}
  </div>
  <div class="paper-row-main">
    <h3><a href={paper.path}>{paper.title}</a></h3>
    {paper.coreSignal && <p>{paper.coreSignal}</p>}
    {paper.authors && paper.authors !== 'Unknown' && (
      <p class="paper-row-authors">
        <AuthorList authors={paper.authors} authorEntries={paper.authorEntries} limit={10} />
      </p>
    )}
    <div class="paper-row-meta">
      <span class:list={['paper-review-badge', `is-${reviewStatus}`]}>{paperReviewLabel(reviewStatus)}</span>
      {paper.pinned && <span class="paper-row-pin">Pinned</span>}
      {showProvenance && <span>{paper.slug}</span>}
      {paper.tags?.slice(0, 3).map((tag, index) => (
        <a class="topic-link" href={`/topics/#tag-${paper.tagIds?.[index]}`}>{tag}</a>
      ))}
    </div>
  </div>
</article>
