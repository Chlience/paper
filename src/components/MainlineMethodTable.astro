---
interface IncomingRelation {
  relationId: string;
  fromId?: string;
  fromName: string;
  nature: string;
  natureLabel?: string;
  evidenceKind: string;
  evidenceLabel?: string;
  evidenceUrl?: string;
  evidence?: Array<{
    kind: string;
    label: string;
    url?: string;
    locator?: string;
    claim?: string;
  }>;
  note?: string;
}

interface MethodRow {
  id: string;
  name: string;
  date: string;
  dateLabel?: string;
  archiveStatus?: 'full-note' | 'embedded' | 'external';
  paperPath?: string;
  sourceUrl?: string;
  sourceLabel?: string;
  recognition?: Array<{
    kind: string;
    label: string;
    url?: string;
    note?: string;
  }>;
  priorProblem: string;
  optimization: string;
  incoming: IncomingRelation[];
}

interface Props {
  methods: MethodRow[];
  label?: string;
}

const { methods, label = '方法继承关系' } = Astro.props;
const methodHref = (method: MethodRow) => method.paperPath || method.sourceUrl || '';
const archiveLabel = (method: MethodRow) => {
  if (method.archiveStatus === 'external') return '未归档';
  if (method.archiveStatus === 'embedded') return '综合材料';
  return '独立归档';
};
---

<div
  class="mainline-method-table-scroll"
  role="region"
  aria-label={`${label}，可横向滚动`}
  tabindex="0"
>
  <table class="mainline-method-table">
    <caption>{label}</caption>
    <thead>
      <tr>
        <th scope="col">时间</th>
        <th scope="col">方法</th>
        <th scope="col">前序方法与关系</th>
        <th scope="col">前序暴露的问题</th>
        <th scope="col">本方法的优化</th>
      </tr>
    </thead>
    <tbody>
      {methods.map((method) => {
        const href = methodHref(method);
        return (
          <tr id={`method-${method.id}`} tabindex="-1">
            <td>
              <time datetime={method.date}>{method.dateLabel || method.date}</time>
            </td>
            <th scope="row">
              {href ? <a href={href}>{method.name}</a> : <span>{method.name}</span>}
              <span class:list={[
                'mainline-method-source',
                method.archiveStatus === 'external' && 'is-external',
                method.archiveStatus === 'embedded' && 'is-embedded',
              ]}>
                {archiveLabel(method)}
              </span>
              {method.sourceLabel && method.sourceUrl && method.sourceUrl !== href && (
                <a
                  class="mainline-method-canonical"
                  href={method.sourceUrl}
                  aria-label={`${method.name}原文：${method.sourceLabel}`}
                >原文</a>
              )}
              {(method.recognition?.length ?? 0) > 0 && (
                <ul class="mainline-method-recognition" aria-label={`${method.name}的外部认可依据`}>
                  {method.recognition?.map((item) => (
                    <li>
                      {item.url ? <a href={item.url}>{item.label}</a> : <span>{item.label}</span>}
                      {item.note && <small>{item.note}</small>}
                    </li>
                  ))}
                </ul>
              )}
            </th>
            <td>
              {method.incoming.length > 0 ? (
                <ul class="mainline-relation-list">
                  {method.incoming.map((relation) => (
                    <li data-relation-id={relation.relationId}>
                      {relation.fromId ? (
                        <a class="mainline-relation-source" href={`#method-${relation.fromId}`}>{relation.fromName}</a>
                      ) : (
                        <span class="mainline-relation-source">{relation.fromName}</span>
                      )}
                      <span class:list={['mainline-relation-kind', `is-${relation.nature}`]}>
                        {relation.natureLabel || relation.nature}
                      </span>
                      {(relation.evidence?.length ?? 0) > 0 ? (
                        <span class="mainline-relation-evidence">
                          {relation.evidence?.map((evidence) => (
                            <span class="mainline-relation-evidence-item">
                              {evidence.url ? (
                                <a
                                  href={evidence.url}
                                  aria-label={`${relation.fromName}${relation.nature === 'parallel-route' ? '与' : '到'}${method.name}的${evidence.label}${evidence.locator ? `：${evidence.locator}` : ''}`}
                                >{evidence.label}</a>
                              ) : (
                                <span>{evidence.label}</span>
                              )}
                              {evidence.locator && <small>{evidence.locator}</small>}
                            </span>
                          ))}
                        </span>
                      ) : relation.evidenceUrl ? (
                        <a href={relation.evidenceUrl}>
                          {relation.evidenceLabel || relation.evidenceKind}
                        </a>
                      ) : (
                        <span>{relation.evidenceLabel || relation.evidenceKind}</span>
                      )}
                      {relation.note && <small>{relation.note}</small>}
                    </li>
                  ))}
                </ul>
              ) : (
                <span class="mainline-relation-empty">当前无可核验前序</span>
              )}
            </td>
            <td>{method.priorProblem}</td>
            <td>{method.optimization}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
