---
import { paperReviewLabel } from '../lib/paper-review.mjs';
import { paths } from '../lib/site';

const { mainline } = Astro.props;
---

<header class="paper-header synthesis-header mainline-detail-header">
  <a class="mainline-back-link mono" href={paths.mainlines}>← 研究主线</a>
  <p class="synthesis-kicker">用户定义研究主线</p>
  <h1>{mainline.title}</h1>
  <p class="deck">{mainline.researchQuestion}</p>

  {mainline.searchWindow && (
    <div class="synthesis-window" aria-label={`研究窗口 ${mainline.searchWindow.label}`}>
      <span class="synthesis-window-label">材料窗口</span>
      <span class="synthesis-window-range mono">
        <time datetime={mainline.searchWindow.start}>{mainline.searchWindow.start}</time>
        <span class="synthesis-window-arrow" aria-hidden="true">→</span>
        <time datetime={mainline.searchWindow.end}>{mainline.searchWindow.end}</time>
      </span>
      <span class="synthesis-window-cutoff">检索截止 {mainline.searchWindow.cutoff}</span>
    </div>
  )}

  <div class="paper-meta">
    <div class="paper-meta-line" role="group" aria-label="主线文章状态与来源">
      <span class:list={['paper-meta-item', 'paper-review-badge', `is-${mainline.reviewStatus}`]}>
        {paperReviewLabel(mainline.reviewStatus)}
      </span>
      <a class="paper-meta-item synthesis-kind" href={paths.synthesisWorkflow}>主线综合 SOP</a>
      <span class="paper-meta-item">Started {mainline.firstArchivedAt}</span>
      {mainline.updatedAt !== mainline.firstArchivedAt && <span class="paper-meta-item">Updated {mainline.updatedAt}</span>}
      {mainline.reviewedAt && <span class="paper-meta-item">Reviewed {mainline.reviewedAt}</span>}
      <span class="paper-meta-item">{mainline.sourceCount} 项材料</span>
    </div>
    <div class="paper-meta-line paper-meta-topics" role="group" aria-label="主线分类框架">
      {mainline.classificationAxes.map((axis) => <span class="paper-topic">{axis}</span>)}
    </div>
  </div>
</header>
