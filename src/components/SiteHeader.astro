---
import PaperSearchDialog from './PaperSearchDialog.astro';
import { paths } from '../lib/site';

interface Props {
  active?: 'home' | 'papers' | 'topics' | 'authors' | 'archive' | 'workflow';
}

const { active = 'home' } = Astro.props;

const navItems = [
  { id: 'home', label: '首页', href: paths.home },
  { id: 'papers', label: '论文', href: paths.papers },
  { id: 'topics', label: '主题', href: paths.topics },
  { id: 'authors', label: '作者', href: paths.authors },
  { id: 'archive', label: '索引', href: paths.archive },
  { id: 'workflow', label: '工作流', href: paths.workflow },
] as const;
---

<header class="site-header">
  <div class="container site-header-inner">
    <a class="brand" href={paths.home}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span>Paper Archive</span>
    </a>

    <nav class="site-nav" aria-label="站点导航">
      {navItems.map((item) => (
        <a href={item.href} class:list={[active === item.id && 'is-active']}>{item.label}</a>
      ))}
      <a href={paths.mainSite}>主站</a>
      <button type="button" class="site-search-trigger" data-paper-search-open>
        <span>搜索</span>
        <kbd>⌘K</kbd>
      </button>
    </nav>
    <PaperSearchDialog />
  </div>
</header>
