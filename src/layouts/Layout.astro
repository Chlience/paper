---
import '../styles/site.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { createWebsiteJsonLd, getAbsoluteUrl, siteDescription, siteTitle } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  active?: 'home' | 'papers' | 'topics' | 'mainlines' | 'authors' | 'conferences' | 'archive' | 'workflow';
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteTitle,
  description = siteDescription,
  canonicalPath = Astro.url.pathname,
  active = 'home',
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

const canonicalUrl = getAbsoluteUrl(canonicalPath, Astro.site);
const jsonLdItems = [
  createWebsiteJsonLd(Astro.site),
  ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]),
].filter(Boolean);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script
      is:inline
      defer
      src="https://umami.chlience.com/script.js"
      data-website-id="adb2da68-eff5-4878-9124-14cbde61f171"
    ></script>
    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <SiteHeader active={active} />
    <main>
      <slot />
    </main>
    <dialog class="paper-figure-dialog" data-paper-figure-dialog aria-label="图片详情" tabindex="-1">
      <figure class="paper-figure-dialog-panel">
        <div class="paper-figure-dialog-media">
          <img data-paper-figure-dialog-image alt="" />
        </div>
        <figcaption class="paper-figure-dialog-caption" data-paper-figure-dialog-caption></figcaption>
      </figure>
    </dialog>
    <SiteFooter />
    <script>
      const figureDialog = document.querySelector('[data-paper-figure-dialog]');
      const figureDialogImage = figureDialog?.querySelector('[data-paper-figure-dialog-image]');
      const figureDialogCaption = figureDialog?.querySelector('[data-paper-figure-dialog-caption]');
      let lastFigureTrigger = null;

      const closeFigureDialog = () => {
        if (figureDialog instanceof HTMLDialogElement && figureDialog.open) {
          figureDialog.close();
        }
      };

      if (
        figureDialog instanceof HTMLDialogElement &&
        figureDialogImage instanceof HTMLImageElement &&
        figureDialogCaption instanceof HTMLElement
      ) {
        document.querySelectorAll('[data-paper-figure-open]').forEach((trigger) => {
          trigger.addEventListener('click', (event) => {
            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }

            const image = trigger.querySelector('img');
            if (!(image instanceof HTMLImageElement)) return;

            event.preventDefault();
            lastFigureTrigger = trigger;
            const source = trigger.href || image.currentSrc || image.src;
            const caption = trigger.closest('[data-paper-figure]')?.querySelector('figcaption');

            figureDialogImage.src = source;
            figureDialogImage.alt = image.alt || '';
            figureDialogCaption.innerHTML = caption?.innerHTML ?? '';
            document.documentElement.classList.add('is-figure-dialog-open');
            figureDialog.showModal();
            figureDialog.focus();
          });
        });

        figureDialog.addEventListener('click', (event) => {
          if (event.target === figureDialog) closeFigureDialog();
        });

        figureDialog.addEventListener('close', () => {
          document.documentElement.classList.remove('is-figure-dialog-open');
          figureDialogImage.removeAttribute('src');
          if (lastFigureTrigger instanceof HTMLElement) {
            lastFigureTrigger.focus();
          }
          lastFigureTrigger = null;
        });
      }
    </script>
  </body>
</html>
